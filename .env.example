# Runtime mode: naive, local, kub, or aws
ENVIRONMENT=local

# Local and Kubernetes input/output configuration
SPARK_MASTER_URL_LOCAL=spark://spark-master:7077
LOG_SOURCE_PATH_LOCAL=./data/api_logs.txt
OUTPUT_DIR_LOCAL=./data/results
SPARK_MASTER_URL_LOCAL_K8S=k8s://https://kubernetes.default.svc:443

# AWS/EKS configuration
SPARK_MASTER_URL_AWS=k8s://https://YOUR_EKS_ENDPOINT
LOG_SOURCE_PATH_AWS=s3a://YOUR_BUCKET/path/to/api_logs.txt
OUTPUT_DIR_AWS=s3a://YOUR_BUCKET/path/to/results
EKS_CLUSTER_NAME=your-eks-cluster
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-2

# Spark event logging
SPARK_EVENT_LOG_ENABLED=true
SPARK_EVENT_LOG_DIR=/app/logs/spark-events
SPARK_HISTORY_OPTS=-Dspark.history.fs.logDirectory=file:///app/logs/spark-events

# Spark application and resources
SPARK_APP_NAME=billing-aggregation
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
SPARK_NUM_EXECUTORS=3
SPARK_DRIVER_BIND_ADDRESS=0.0.0.0
SPARK_DRIVER_HOST=spark-submit
SPARK_DRIVER_PORT=7078
SPARK_K8S_IMAGE=distributed-billing-spark:latest
SPARK_K8S_UPLOAD_PATH=/tmp/spark-upload

# Billing rates per millisecond
RATE_login=0.005
RATE_getUserProfile=0.005
RATE_createOrder=0.010
RATE_updateInventory=0.010
RATE_deleteOrder=0.010

# Application logging
LOG_LEVEL=INFO
